# ブラウザに出してよい Auth0 + Convex の設定。
# SPA の公開値であり、secret ではない。deploy key、client secret、
# Management API credential、R2 secret、VAPID private key を VITE_* に入れない。
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_CONVEX_URL=
VITE_WEB_PUSH_VAPID_PUBLIC_KEY=

# `pnpm convex:dev` / `pnpm dev:full` はマシン上の local Convex を選び、
# CONVEX_DEPLOYMENT と VITE_CONVEX_URL を書き換える（だいたい http://127.0.0.1:3210）。
# local 開発を cloud の developer deployment に向けない。無料枠を食う。
# CI E2E は共有 Preview deployment を使う。手順は docs/development/preview-environment.md。
# CONVEX_DEPLOYMENT=
# cloud の developer deployment を明示選択するときだけ:
# CONVEX_ALLOW_CLOUD_DEV=1

# Convex backend の env（local / Preview / production の deployment に置く。VITE_* にはしない）:
# AUTH0_DOMAIN=
# AUTH0_CLIENT_ID=

# Playwright 用 Auth0 test identity。VITE_ を付けない。browser bundle に入れない。
# production build では VITE_ALLOW_E2E_DB_LOGIN を付けない。
# E2E_AUTH0_EMAIL=
# E2E_AUTH0_PASSWORD=
# E2E_AUTH0_CONNECTION=Username-Password-Authentication
