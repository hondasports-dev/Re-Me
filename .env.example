# ブラウザへ出してよい Auth0 + Worker API の公開設定。
# deploy key、client secret、Management API credential、R2 secret、
# VAPID private key、capability secret は VITE_* に入れない。
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_API_BASE_URL=
VITE_WEB_PUSH_VAPID_PUBLIC_KEY=

# Worker API の環境・secret値（Worker側へ設定し、ブラウザへは出さない）。
# AUTH0_DOMAIN=
# AUTH0_AUDIENCE=
# CAPABILITY_SECRET=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=

# Playwright/Auth0 test identity。production buildでは付けない。
# E2E_AUTH0_EMAIL=
# E2E_AUTH0_PASSWORD=
# E2E_AUTH0_CONNECTION=Username-Password-Authentication
