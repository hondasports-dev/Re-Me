# Browser-visible Auth0 + Convex configuration.
# These are SPA public values, not secrets. Never put deploy keys, client secrets,
# Management API credentials, R2 secrets, or VAPID private keys in VITE_* variables.
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_CONVEX_URL=

# Convex CLI uses this locally after `pnpm convex:dev`. Do not commit the value.
# CONVEX_DEPLOYMENT=

# Convex backend (set on the developer deployment, not in VITE_*):
# AUTH0_DOMAIN=
# AUTH0_CLIENT_ID=

# Playwright Auth0 test identity. Do not prefix with VITE_ — these must never
# enter the browser bundle. Production builds must omit VITE_ALLOW_E2E_DB_LOGIN.
# E2E_AUTH0_EMAIL=
# E2E_AUTH0_PASSWORD=
# E2E_AUTH0_CONNECTION=Username-Password-Authentication

# Legacy browser-visible Supabase configuration. Removed after the auth/backend cutover.
# Use a publishable key here. Never use a secret or service-role key in VITE_* variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Local Supabase Auth Google OAuth (DEV only, legacy).
# These are read by `supabase/config.toml` via env(...) substitution.
# Do not put production Google OAuth credentials here.
# Do not prefix these with VITE_ — they must never enter the browser bundle.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
