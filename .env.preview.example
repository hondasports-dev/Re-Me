# Preview 用のブラウザ公開設定。このファイルを `.env.preview.local` へコピーする。
# VITE_CONVEX_URL は共有 Preview deployment の URL を明示する。deploy が自動注入しない。
# Auth0 の callback / logout / web origin は固定 Worker URL を使い、
# Cloudflare の版付き Preview URL（<version>-re-me-preview...）は使わない。
CLOUDFLARE_ENV=preview
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_CONVEX_URL=
