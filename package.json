{
  "name": "re-me",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "dev:full": "convex dev --start \"vite dev\"",
    "build": "vite build",
    "build:preview": "vite build --mode preview",
    "preview": "vite preview",
    "deploy": "pnpm deploy:preview",
    "deploy:preview": "pnpm build:preview && convex deploy --env-file .env.convex-preview.local && wrangler deploy --env preview",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt . --check",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:unit && pnpm test:convex && pnpm test:worker",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:convex": "vitest run --config vitest.convex.config.ts",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "convex:dev": "convex dev",
    "convex:codegen": "convex codegen",
    "convex:check": "convex dev --once",
    "supabase": "supabase",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset --local --no-seed --yes",
    "db:lint": "supabase db lint --local --level warning",
    "db:advisors": "supabase db advisors --local --type all --level warn --fail-on warn",
    "db:test": "supabase test db --local",
    "db:types": "supabase gen types --local --schema public > supabase/database.generated.ts",
    "cf:typegen": "wrangler types"
  },
  "dependencies": {
    "@auth0/auth0-react": "^2.24.1",
    "@mantine/core": "^8.3.2",
    "@mantine/hooks": "^8.3.2",
    "@mantine/notifications": "^8.3.2",
    "convex": "^1.45.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router": "^7.9.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.52.1",
    "@cloudflare/vitest-pool-workers": "^0.21.3",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "convex-test": "^0.0.56",
    "jsdom": "^27.0.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "supabase": "2.115.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "packageManager": "pnpm@11.1.2"
}
