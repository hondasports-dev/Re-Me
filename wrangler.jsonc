{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // The top-level Worker is local-only. Remote deploys must select an explicit
  // environment so a bare command cannot update a future Production Worker.
  "name": "re-me-local",
  "compatibility_date": "2026-08-18",
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist",
    // React Router client routes fall back to index.html. Hashed /assets/* cache
    // headers live in public/_headers. Do not add application APIs here.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "vars": {
    "APP_ENV": "local",
    "WEB_ORIGINS": "http://127.0.0.1:4173,http://localhost:4173,http://127.0.0.1:5173,http://localhost:5173",
    "E2E_ALLOW_TEST_AUTH": "1",
    "E2E_ALLOW_FORCE_DELIVERY": "1",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "re-me-local",
      "migrations_dir": "./migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "ATTACHMENTS_BUCKET",
      "bucket_name": "re-me-local-attachments",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "NOTIFICATION_QUEUE",
        "queue": "re-me-local-notifications",
      },
    ],
    "consumers": [
      {
        "queue": "re-me-local-notifications",
      },
    ],
  },
  "triggers": {
    "crons": ["*/5 * * * *"],
  },
  "env": {
    "preview": {
      "name": "re-me-preview",
      "workers_dev": true,
      // Auth0 allows the stable Preview callback only. Versioned Preview URLs
      // use a different origin and would fail with Callback URL mismatch.
      "preview_urls": false,
      "vars": {
        "APP_ENV": "preview",
        "WEB_ORIGINS": "https://re-me-preview.hondasports.workers.dev,http://127.0.0.1:4173,http://localhost:4173",
        "E2E_ALLOW_TEST_AUTH": "0",
        "E2E_ALLOW_FORCE_DELIVERY": "1",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "re-me-preview",
          "database_id": "d688b3a0-a948-4f9e-9e21-49050e2f79c8",
          "migrations_dir": "./migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "ATTACHMENTS_BUCKET",
          "bucket_name": "re-me-preview-attachments",
        },
      ],
      "queues": {
        "producers": [
          {
            "binding": "NOTIFICATION_QUEUE",
            "queue": "re-me-preview-notifications",
          },
        ],
        "consumers": [
          {
            "queue": "re-me-preview-notifications",
          },
        ],
      },
      "triggers": {
        "crons": ["*/5 * * * *"],
      },
    },
    "production": {
      "name": "re-me",
      "workers_dev": true,
      "preview_urls": false,
      "vars": {
        "APP_ENV": "production",
        "WEB_ORIGINS": "https://re-me.hondasports.workers.dev",
        "E2E_ALLOW_TEST_AUTH": "0",
        "E2E_ALLOW_FORCE_DELIVERY": "0",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "re-me",
          "database_id": "e129d7d0-2f45-4b17-9ebb-0eb5f781498f",
          "migrations_dir": "./migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "ATTACHMENTS_BUCKET",
          "bucket_name": "re-me-production-attachments",
        },
      ],
      "queues": {
        "producers": [
          {
            "binding": "NOTIFICATION_QUEUE",
            "queue": "re-me-production-notifications",
          },
        ],
        "consumers": [
          {
            "queue": "re-me-production-notifications",
          },
        ],
      },
      "triggers": {
        "crons": ["*/5 * * * *"],
      },
    },
  },
}
